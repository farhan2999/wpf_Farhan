<Window x:Class="WPFACT2Events1.ResoudCalculer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFACT2Events1"
        mc:Ignorable="d"
        Title="ResoudCalculer" Background="CadetBlue" Height="450" Width="800">
    <Grid>
        <TextBlock x:Name="LblResultat" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="50" TextWrapping="Wrap" FontStyle="Italic" FontFamily="Segoe UI Variable Text Semilight" Margin="10,0,0,0" AutomationProperties.HelpText="2" RenderTransformOrigin="1,0.5">
            <TextBlock.BindingGroup>
                <BindingGroup/>
            </TextBlock.BindingGroup>
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="2"/>
                    <SkewTransform AngleX="2"/>
                    <RotateTransform Angle="17.745"/>
                    <TranslateTransform X="4E-06" Y="3"/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
    </Grid>
</Window>
