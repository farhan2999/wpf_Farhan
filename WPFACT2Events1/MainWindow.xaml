<Window x:Class="WPFACT2Events1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFACT2Events1"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="450">
    <Grid Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="3" x:Name="btnCalculer" Content="CALCULER" Background="LightGray"  Width="250" Height="100" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="40,0,0,40" FontSize="36" FontWeight="Bold"/>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0" Margin="40,0,0,0">
            <TextBlock Text="A" Width="60" FontSize="48" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox x:Name="txtA" Width="250" Height="100" FontSize="36" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="1" Margin="40,0,0,0">
            <TextBlock Text="B" Width="60" FontSize="48" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox x:Name="txtB" Width="250" Height="100" FontSize="36" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="2" Margin="40,0,0,0">
            <TextBlock Text="C" Width="60" FontSize="48" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox x:Name="txtC" Width="250" Height="100" FontSize="36" VerticalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
