<Window x:Class="permier_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:permier_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid >
        <Button x:Name="up_left" Content="Up left" HorizontalAlignment="Left" VerticalAlignment="Top"  Foreground="#FFEC3737"/>
        <Button x:Name="down_left" Content="Down left" VerticalAlignment="Bottom" Foreground="#FF184DD0" HorizontalAlignment="Left"/>
        <Button x:Name="bottom_right" Content="bottom Right" VerticalAlignment="Bottom" Foreground="#FF1D226D" HorizontalAlignment="Right"/>
        <Button x:Name="up_rigth" Content="Up Right" VerticalAlignment="Top" Foreground="#FF44E019" HorizontalAlignment="Right"/>
        
        

    </Grid>
</Window>
