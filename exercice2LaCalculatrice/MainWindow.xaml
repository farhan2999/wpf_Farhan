<Window x:Class="exercice2LaCalculatrice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:exercice2LaCalculatrice"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="450" Background="Gray">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
            <Border Width="280" Height="80" Background="White" CornerRadius="5" Margin="0,0,10,0">
                <TextBlock x:Name="txtEcran" Text="0" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"/>
            </Border>
            <Button Width="80" Height="80" Background="Red" FontWeight="Bold" FontSize="30" Content="C"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">1</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">2</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">3</Button>
                <Button Width="80" Height="80" Background="Green" Margin="5" FontWeight="Bold" FontSize="30">+</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">4</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">5</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">6</Button>
                <Button Width="80" Height="80" Background="Green" Margin="5" FontWeight="Bold" FontSize="30">-</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">7</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">8</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">9</Button>
                <Button Width="80" Height="80" Background="Green" Margin="5" FontWeight="Bold" FontSize="30">/</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Button Width="80" Height="80" Background="AliceBlue" Margin="5" FontWeight="Bold" FontSize="30">,</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="5" FontWeight="Bold" FontSize="30">0</Button>
                <Button Width="80" Height="80" Background="Green" Margin="5" FontWeight="Bold" FontSize="30">*</Button>
                <Button Width="80" Height="80" Background="YellowGreen" Margin="5" FontWeight="Bold" FontSize="30">=</Button>
            </StackPanel>
        </StackPanel>
    </Grid>

</Window>
