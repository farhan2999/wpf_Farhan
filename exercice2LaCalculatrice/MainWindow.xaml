<Window x:Class="exercice2LaCalculatrice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:exercice2LaCalculatrice"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="450" Background="Gray">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Rectangle Width="300" Height="100" Fill="White" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,10,0,0" />
            <Button Width="80" Height="80" Background="Red" VerticalAlignment="Top" HorizontalAlignment="Right"  Margin="40,110,0,0" FontWeight="Bold" FontSize="30" >C</Button>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" >
            <StackPanel Orientation="Horizontal">
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >1</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >2</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >2</Button>
                <Button Width="80" Height="80" Background="Green" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >+</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >4</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >5</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >6</Button>
                <Button Width="80" Height="80" Background="Green" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >-</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >7</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >8</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >9</Button>
                <Button Width="80" Height="80" Background="Green" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >/</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="80" Height="80" Background="AliceBlue" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >,</Button>
                <Button Width="80" Height="80" Background="BlueViolet" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >0</Button>
                <Button Width="80" Height="80" Background="Green" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >*</Button>
                <Button Width="80" Height="80" Background="YellowGreen" Margin="25,10,0,0" FontWeight="Bold" FontSize="30" >=</Button>
            </StackPanel>
        </StackPanel>
        
            

    </Grid>
</Window>
