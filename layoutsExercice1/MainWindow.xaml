<Window x:Class="layoutsExercice1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:layoutsExercice1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Column="1">
            <Button DockPanel.Dock="Top" Height="50">Top</Button>
            <Button DockPanel.Dock="Bottom" Height="50">Botton</Button>
            <Button DockPanel.Dock="Left" Width="50">Left</Button>
            <Button DockPanel.Dock="Right" Width="50">Right</Button>
            <Button>Dierction</Button>
        </DockPanel>
        <StackPanel>
            <Button Height="100">button 1</Button>
            <Button Height="100">button 2</Button>
        </StackPanel>
        <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1">
            
            <Button Width="100"> button 1</Button>
            <Button Width="100">button 2</Button>
            <Button Width="100">button 3</Button>
            <Button Width="100" Height="100" >button 4</Button>
            <Button Width="100" >button 5</Button>
            <Button Width="100"  >button 6</Button>
        </WrapPanel>
        <Canvas Grid.Column="2" Grid.Row="2" Background="Orange">
            <Ellipse Fill="Black" Height="150" Canvas.Left="75" Stroke="White" Canvas.Top="25" Width="150"/>
            <Ellipse Fill="Yellow" Height="100" Canvas.Left="100" Stroke="Yellow" Canvas.Top="50" Width="100"/>
            <Ellipse Fill="Red" Height="50" Canvas.Left="125" Stroke="Red" Canvas.Top="75" Width="50"/>
            
        </Canvas>
        


    </Grid>
</Window>
