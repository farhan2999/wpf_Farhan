        <Button x:Name="bottom_right" Content="B4" VerticalAlignment="Center" Foreground="#FF1D226D" HorizontalAlignment="Center" Margin="120,0,0,0" Width="40" Height="40"/>
        <Button x:Name="up_rigth" Content="B3" VerticalAlignment="Center" Foreground="#FF44E019" HorizontalAlignment="Center" Margin="40,0,0,0" Width="40" Height="40"/>
        
        

    </Grid>
